# Copy this file to .env.local and fill it in. Never commit .env.local.
# Next.js reads .env.local at startup, so restart `npm run dev` after editing it.

# The Drip PORTAL API (drip_backend: `python -m drip.portal.app`).
# The site proxies /api/portal/* to it, and its server pages call it directly.
# This is port 8001. Port 8000 is the separate duplicate-detection API, which the
# site does not use. Set this when you BUILD the site as well as when you run it.
PORTAL_API_URL=http://127.0.0.1:8001

# Contact form (Google Apps Script endpoint and its key)
CONTACT_FORM_SCRIPT_URL=
CONTACT_FORM_API_KEY=

# PostHog analytics (public values, safe in the browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
